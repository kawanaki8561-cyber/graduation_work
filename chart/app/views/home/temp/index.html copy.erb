<!-- 1. グラフタイプを選ぶプルダウンを追加 -->
<div style="margin-bottom: 20px;">
  <label for="chartType">グラフの種類を選択:</label>
  <select id="chartType">
    <option value="bar" selected>棒グラフ (Bar)</option>
    <option value="line">折れ線グラフ (Line)</option>
    <option value="pie">パイグラフ (Pie)</option>
    <option value="doughnut">ドーナツグラフ (Doughnut)</option>
    <option value="radar">レーダーチャート (Radar)</option>
    <option value="polarArea">ポーラーエリア (PolarArea)</option>
  </select>
</div>


<div class="chart-container" style="position: relative; width: 90%; max-width: 800px; margin: auto;">
<canvas id="myChart"></canvas>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
// --- 既存のグラフ初期化コード ---
const ctx = document.getElementById('myChart');
const myChart = new Chart(ctx, {
    type: 'bar', // 初期タイプ
    data: {
        labels: ['Red', 'Blue', 'Yellow', 'Green', 'Purple', 'Orange'],
        datasets: [{
            label: '# of Votes',
            data: [12, 19, 3, 5, 2, 3],
            backgroundColor: [
                'rgba(255, 99, 132, 0.2)',
                'rgba(54, 162, 235, 0.2)',
                'rgba(255, 206, 86, 0.2)',
                'rgba(75, 192, 192, 0.2)',
                'rgba(153, 102, 255, 0.2)',
                'rgba(255, 159, 64, 0.2)'
            ],
            borderColor: [
                'rgba(255, 99, 132, 1)',
                'rgba(54, 162, 235, 1)',
                'rgba(255, 206, 86, 1)',
                'rgba(75, 192, 192, 1)',
                'rgba(153, 102, 255, 1)',
                'rgba(255, 159, 64, 1)'                
            ],
            borderWidth: 1
        }]
    },
    options: {
        scales: {
            y: { beginAtZero: true }
        }
    }
});

// --- 2. ここから追加：グラフタイプの切り替えイベントリスナー ---
document.getElementById('chartType').addEventListener('change', (event) => {
    // 選択された新しいタイプを取得
    const newType = event.target.value;
    
    // グラフインスタンスのconfig.typeを直接書き換える
    myChart.config.type = newType;
    
    // 最後にupdate()を呼ぶだけで、スムーズに切り替わります
    myChart.update();
});
</script>