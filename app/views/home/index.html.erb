<h1>SPCデータ解析アプリ</h1>
<%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>


<h2>グラフ解析領域</h2>

<div data-controller="spc-chart">
 
    <input type="file" accept=".csv" data-action="change->spc-chart#handleFileUpload">
    <!-- カラム選択用のセレクトボックスを追加 -->
    <div class="spc-chart-selection">
      <label>Y軸カラム選択</label>

      <!-- ▼▼ data-action を追加 ▼▼ -->      
      <select data-spc-chart-target="select" data-action="change->spc-chart#extractData">
        <option value="" >カラムを選択してください</option>
      </select>
    </div>
    <!-- 解析結果を表示するための領域を追加 -->
    <div class="spc-chart-section">
      <!-- ▼ SPC計算結果出力用Target群を追加 ▼ -->
      <div class="spc-results">
        <ul>
          <li>平均 (CL): <span data-spc-chart-target="mean"></span></li>
          <li>標準偏差 (σ): <span data-spc-chart-target="stddev"></span></li>
          <li>UCL (+3σ): <span data-spc-chart-target="ucl"></span></li>
          <li>LCL (-3σ): <span data-spc-chart-target="lcl"></span></li>
          <li>外れ値のインデックス (TEST1): <span data-spc-chart-target="outliers"></span></li>
        </ul>
      </div>
      <!-- ▲ ここまで ▲ -->

      <h3>解析結果プレビュー:</h3>
      <pre data-spc-chart-target="output" class="spc-chart-preview"></pre>
    </div>
 
</div>