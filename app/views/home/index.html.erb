<h1>SPCデータ解析アプリ</h1>
<%= button_to 'ログアウト', destroy_user_session_path, method: :delete %>


<h2>グラフ解析領域</h2>

<div data-controller="spc-chart">
 
    <input type="file" accept=".csv" data-action="change->spc-chart#handleFileUpload">

      <!-- 解析結果を表示するための領域を追加 -->
    <div style="margin-top: 20px;">
      <h3>解析結果プレビュー:</h3>
      <pre data-spc-chart-target="output" style="background: #f4f4f4; padding: 10px;"></pre>
    </div>
 
</div>