<div class="container py-5 mt-5 mb-5">
  <div class="row justify-content-center mt-5">
    <div class="col-12 col-lg-10 d-flex flex-column flex-md-row align-items-center justify-content-center gap-5 mt-5">
      
      <!-- Left Column: Illustration Logo -->
      <div class="col-md-5 d-flex justify-content-center">
        <img alt="AnalyticsApp Logo" class="img-fluid" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBSIPb5jvaPcGkmUsmnvnvAqK98PIK9X0_-DdpxQpgg-lbEkDp0S_qzc0qr4BqL2d032DUbxz9ve11k13CBGXZ6bGIf15rySrMPm7QeADSSRHTORGwI-m7KEtaHCTpanVJODMBKAwVVlfMmIM6l6pA8eyR7eaXlklmYeTKsR-bjVVBVwXwQYbASHMiebvT5WnyVnEqjpPF1enGVEgXk4rZX9x4bOdQEILMPaRd21EDgdIb2WSacv9aEXGldh29wn5JnyA" style="max-width: 300px;"/>
      </div>
      
      <!-- Right Column: Devise Form -->
      <div class="col-md-6">
        <h1 class="text-center text-md-start mb-5 fw-normal display-6 letter-spacing-lg">ログイン</h1>
        
        <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
          <div class="mb-4">
            <%= f.label :email, "Email", class: "form-label label-style", for: "email" %>
            <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "name@company.com", required: true, class: "form-control form-control-lg", id: "email" %>
          </div>

          <div class="mb-4">
            <%= f.label :password, "password", class: "form-label label-style", for: "password" %>
            <%= f.password_field :password, autocomplete: "current-password", placeholder: "••••••••", required: true, class: "form-control form-control-lg", id: "password" %>
          </div>

          <% if devise_mapping.rememberable? %>
            <div class="mb-4 form-check">
              <%= f.check_box :remember_me, class: "form-check-input" %>
              <%= f.label :remember_me, "ログイン情報を記憶する", class: "form-check-label" %>
            </div>
          <% end %>

          <div class="d-flex justify-content-end mt-4">
            <%= f.submit "ログイン", class: "btn btn-custom-gray btn-large-custom fw-bold" %>
          </div>
        <% end %>

        <!-- Devise Links / Signup Redirect -->
        <div class="mt-5 text-center text-md-start">
          <p class="text-secondary">
            アカウントをお持ちでないですか？ 
            <%= link_to "無料で開始する", new_registration_path(resource_name), class: "text-dark fw-bold text-decoration-underline" %>
          </p>
          <!-- その他のDeviseリンクが必要な場合はこちらを有効にしてください -->
          <%#= render "devise/shared/links" %>
        </div>
      </div>
      
    </div>
  </div>
</div>