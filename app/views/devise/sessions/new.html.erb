<div class="container py-5">
  <div class="text-center mb-5">
    <h1 class="display-6 fw-normal">サインイン</h1>
  </div>
  
  <div class="row align-items-center justify-content-center px-3">
    <!-- Hero Image Column (イラスト部分) -->
    <div class="col-md-5 d-flex justify-content-center mb-4 mb-md-0">
      <div class="hero-img-container">
        <img alt="Analytics Illustration" class="hero-img" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC97V7iL6i2LvoXYyWfpRYbHkezET3ej3fO0RikEM_UDMZL4QLvkHrzUxEKyEIX2ETevaN7w-IPMksC4YCCay_KWU1f0fhvX3ZF_hBFjg7floFwvcVBiethJYyk9caZ40UN3ejoq6Sw6Egzsh6h06BQAUoghZdDX_81UwGP37_7lfq5y8s-aefLZ_i7BSKcHcd_-EZY0ZvCkfyFcqmbQ4wSS_0KdMrxQXW8ou3BmrtJ_1eo6im-FP1TYWofPTvFc2_HmA"/>
      </div>
    </div>
    
    <!-- Form Column (ログインフォーム部分) -->
    <div class="col-md-5">
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "mx-auto", style: "max-width: 320px;" }) do |f| %>
        <div class="mb-3">
          <%= f.label :email, "Email", class: "form-label fs-5 mb-1" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control form-control-custom" %>
        </div>

        <div class="mb-3">
          <%= f.label :password, "password", class: "form-label fs-5 mb-1" %>
          <%= f.password_field :password, autocomplete: "current-password", class: "form-control form-control-custom" %>
        </div>

        <% if devise_mapping.rememberable? %>
          <div class="mb-4 form-check">
            <%= f.check_box :remember_me, class: "form-check-input" %>
            <%= f.label :remember_me, "ログイン情報を記憶する", class: "form-check-label" %>
          </div>
        <% end %>

        <div class="text-center mt-4">
          <%= f.submit "サインイン", class: "btn btn-brand-gray-lg px-5" %>
        </div>
      <% end %>

      <!-- Devise Links (パスワード忘れや新規登録へのリンク) -->
      <div class="mt-4 text-center" style="max-width: 320px; margin: 0 auto;">
        <%= render "devise/shared/links" %>
      </div>
    </div>
  </div>
</div>